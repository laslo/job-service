# Copy to `.env` and adjust values for local development.
# `.env` is gitignored; only `.env.example` (this file) is committed.
# Loaded by Node via `--env-file=.env` (no dotenv dependency).

# --- PostgreSQL (Stage 2) -----------------------------------------------------
# Connection string used by the API service, workers, and `pnpm db:*` scripts.
# Matches the defaults baked into infra/docker-compose.dev.yml.
DATABASE_URL=postgres://job_service:job_service@localhost:5432/job_service

# Optional overrides consumed by infra/docker-compose.dev.yml. Defaults match
# DATABASE_URL above; change in lock-step if you customize them.
POSTGRES_USER=job_service
POSTGRES_PASSWORD=job_service
POSTGRES_DB=job_service
POSTGRES_PORT=5432

# --- Job service HTTP API (Stage 3) -------------------------------------------
# Bind host and port for `apps/job-service`. Override in `.env` if 4000 collides
# locally; the same values are used by curl examples in the README.
JOB_SERVICE_HOST=0.0.0.0
JOB_SERVICE_PORT=4000

# --- Kafka (Stage 4) ----------------------------------------------------------
# Master switch for Kafka integration. Set to `false` to run Stages 1–3 without
# starting a broker; the API skips the producer and the events-logger app
# exits cleanly. Default `true`.
KAFKA_ENABLED=true

# Comma-separated list of bootstrap brokers (host:port). Matches the listener
# advertised by infra/docker-compose.dev.yml.
KAFKA_BOOTSTRAP_BROKERS=localhost:9092

# Host port the local broker is exposed on. Override here AND in
# KAFKA_BOOTSTRAP_BROKERS in lock-step if 9092 collides.
KAFKA_PORT=9092

# Logical client identity for kafkajs. Each process can override this; the
# default is fine for local development.
KAFKA_CLIENT_ID=job-service

# Optional kafkajs log level (NOTHING|ERROR|WARN|INFO|DEBUG). Defaults to WARN.
# KAFKAJS_LOG_LEVEL=WARN

# --- CPU job worker (Stage 5) -------------------------------------------------
# Per-job wall-clock budget in milliseconds. The handler aborts the SHA-256
# loop and transitions the row to `failed` with a JOB_CPU_TIMEOUT_MS=… message
# once this is exceeded. Defaults to 30s (range: 100…600000).
JOB_CPU_TIMEOUT_MS=30000

# Default SHA-256 iteration count when a job's payload omits `iterations`.
# Sized for ~200ms on commodity hardware; tune up to simulate slow jobs or
# down for CI / weak machines. Range: 1…JOB_CPU_MAX_ITERATIONS.
JOB_CPU_DEFAULT_ITERATIONS=200000

# Hard ceiling on `payload.iterations`; values above this are rejected so a
# poison message cannot stall a worker. Range: ≥JOB_CPU_DEFAULT_ITERATIONS.
JOB_CPU_MAX_ITERATIONS=5000000
