{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "allowJs": true,
    "checkJs": false
  },
  "include": [
    "scripts/**/*",
    "*.config.ts",
    "*.config.mjs",
    "packages/*/src/**/*",
    "packages/*/scripts/**/*",
    "packages/*/drizzle.config.ts",
    "apps/*/src/**/*",
    "apps/*/scripts/**/*",
    "apps/*/test/**/*"
  ],
  "exclude": [
    "node_modules",
    "**/node_modules/**",
    "dist",
    "**/dist/**",
    ".turbo",
    ".next",
    "**/drizzle/**"
  ]
}
